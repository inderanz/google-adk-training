# Copy to .env in a separate practice checkout; replace all placeholders.
# Local tests do not need these values. Never commit .env or credential files.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=YOUR_MODEL_LOCATION
GEMINI_MODEL=gemini-3.8-flash
BIGQUERY_LOCATION=YOUR_DATASET_LOCATION
CORPORATE_PROFILES_TABLE=YOUR_PROJECT_ID.sentinel.company_profiles
