# Copy into your practice directory and replace the placeholders.
# The offline session probe and unit tests do not need this file.
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=YOUR_DEVELOPMENT_PROJECT
GOOGLE_CLOUD_LOCATION=YOUR_MODEL_LOCATION
GEMINI_MODEL=gemini-3.8-flash
FIRESTORE_DATABASE=(default)
SESSION_BACKEND=sqlite
SESSION_DB_URL=sqlite+aiosqlite:///./review_sessions.db
# Managed sessions: install the managed extra and select SESSION_BACKEND=managed.
GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=YOUR_SESSION_RESOURCE_LOCATION
GOOGLE_CLOUD_AGENT_ENGINE_ID=YOUR_AGENT_RUNTIME_RESOURCE_ID
# For the local Firestore emulator only; remove for real cloud calls:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
