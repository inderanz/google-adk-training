{
  "name": "gyanhq-training-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser.mjs",
    "test:capacity": "node scripts/capacity.mjs",
    "test:worker": "node scripts/worker-smoke.mjs",
    "dev": "wrangler dev --env local",
    "preview:login": "node scripts/preview-login.mjs",
    "check": "wrangler deploy --dry-run --env staging",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "wrangler": "^4.0.0"
  }
}
